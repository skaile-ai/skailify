{
  "name": "skailify-adapters",
  "private": true,
  "license": "Apache-2.0",
  "description": "Workspace root for the JavaScript Skailify adapters",
  "workspaces": [
    "frontend/*",
    "backend/*"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run --filter './frontend/*' --filter './backend/*' --if-present build && changeset publish"
  }
}
