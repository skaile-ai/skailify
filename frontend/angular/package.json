{
  "name": "@skaile/skailify-angular",
  "version": "0.2.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Skailify adapter for Angular apps: makes their views, state, NgRx store and actions agent-controllable over the Skaile app channel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaile-ai/skailify.git",
    "directory": "frontend/angular"
  },
  "homepage": "https://github.com/skaile-ai/skailify/tree/main/frontend/angular#readme",
  "bugs": {
    "url": "https://github.com/skaile-ai/skailify/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ngrx": {
      "types": "./dist/ngrx.d.ts",
      "import": "./dist/ngrx.js",
      "default": "./dist/ngrx.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./ngrx-signals": {
      "types": "./dist/ngrx-signals.d.ts",
      "import": "./dist/ngrx-signals.js",
      "default": "./dist/ngrx-signals.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "check:package": "bun run build && publint --strict",
    "test": "bun test --preload ./test/setup.ts ./test/unit",
    "conformance": "bun test --preload ./test/setup.ts ./test/conformance",
    "type-check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@skaile/skailify-core": "^0.1.0"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/router": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@ngrx/signals": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@ngrx/store": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@skaile/workspaces": "^10.14.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    },
    "@ngrx/signals": {
      "optional": true
    },
    "@ngrx/store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@skaile/workspaces": "10.14.0",
    "@types/bun": "^1.3.0",
    "publint": "0.3.25",
    "rxjs": "^7.8.0",
    "tsdown": "0.23.7",
    "typescript": "~5.9.2",
    "zod": "^4.4.0"
  }
}
