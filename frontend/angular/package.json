{
  "name": "@skaile/skailify-angular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Skailify adapter for Angular apps: makes their views, state, NgRx store and actions agent-controllable over the Skaile app channel",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ngrx": {
      "types": "./src/ngrx.ts",
      "import": "./src/ngrx.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "import": "./src/router.ts"
    },
    "./ngrx-signals": {
      "types": "./src/ngrx-signals.ts",
      "import": "./src/ngrx-signals.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "bun test --preload ./test/setup.ts ./test/unit",
    "conformance": "bun test --preload ./test/setup.ts ./test/conformance",
    "type-check": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/router": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@ngrx/signals": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@ngrx/store": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@skaile/workspaces": "^10.4.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    },
    "@ngrx/signals": {
      "optional": true
    },
    "@ngrx/store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@skaile/workspaces": "10.11.0",
    "@types/bun": "^1.3.0",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.2",
    "zod": "^4.4.0"
  }
}
