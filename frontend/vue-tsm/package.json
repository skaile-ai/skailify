{
  "name": "@skaile/skailify-vue-tsm",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Skailify adapter for Vue 3 apps on the tsm module runtime: makes their views, lists and UIModel forms agent-controllable over the Skaile app channel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaile-ai/skailify.git",
    "directory": "frontend/vue-tsm"
  },
  "homepage": "https://github.com/skaile-ai/skailify/tree/main/frontend/vue-tsm#readme",
  "bugs": {
    "url": "https://github.com/skaile-ai/skailify/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "check:package": "bun run build && publint --strict",
    "test": "vue-tsc --noEmit -p . && bun test ./test/unit",
    "conformance": "bun test ./test/conformance",
    "type-check": "vue-tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@eclipse-daanse/tsm": "~0.1.0-next.1",
    "@emfts/core": "~0.3.0-next.4",
    "@emfts/uimodel-composer": "~0.0.2-next.1",
    "@skaile/workspaces": "^10.14.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@eclipse-daanse/tsm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eclipse-daanse/tsm": "0.1.0-next.1",
    "@emfts/core": "0.3.0-next.4",
    "@emfts/uimodel-composer": "0.0.2-next.1",
    "@skaile/skailify-core": "^0.1.0",
    "@skaile/workspaces": "10.14.0",
    "@types/bun": "^1.3.12",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "~5.9.2",
    "vue": "^3.5.13",
    "vue-router": "^5.0.1",
    "vue-tsc": "^3.2.2",
    "zod": "^4.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
