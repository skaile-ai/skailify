{
  "name": "@skaile/skailify-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Skailify adapter for React apps: makes their views, state and actions agent-controllable over the Skaile app channel",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "README.md", "AGENTS.md"],
  "scripts": {
    "test": "bun test --preload ./test/dom.ts ./test/unit",
    "conformance": "bun test ./test/conformance",
    "type-check": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@skaile/workspaces": "^10.4.0",
    "react": "^18.3.0 || ^19.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@skaile/workspaces": "10.11.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.2",
    "zod": "^4.4.0"
  }
}
