{
  "name": "@skaile/skailify-react",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Skailify adapter for React apps: makes their views, state and actions agent-controllable over the Skaile app channel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaile-ai/skailify.git",
    "directory": "frontend/react"
  },
  "homepage": "https://github.com/skaile-ai/skailify/tree/main/frontend/react#readme",
  "bugs": {
    "url": "https://github.com/skaile-ai/skailify/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "check:package": "bun run build && publint --strict",
    "test": "bun test --preload ./test/dom.ts ./test/unit",
    "conformance": "bun test ./test/conformance",
    "type-check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@skaile/skailify-core": "^0.1.0"
  },
  "peerDependencies": {
    "@skaile/workspaces": "^10.14.0",
    "react": "^18.3.0 || ^19.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@skaile/workspaces": "10.14.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "publint": "0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "0.23.7",
    "typescript": "~5.9.2",
    "zod": "^4.4.0"
  }
}
